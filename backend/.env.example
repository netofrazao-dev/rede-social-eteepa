# Porta em que a API vai rodar
PORT=4000

# Segredo usado para assinar os tokens JWT. TROQUE por algo grande e aleatório.
JWT_SECRET=troque-este-segredo-por-uma-frase-bem-grande-e-secreta

# Validade do token (ex: 1h, 7d, 30d)
JWT_EXPIRES=7d

# URL pública da API (usada para montar o link das imagens/vídeos enviados)
BASE_URL=http://localhost:4000

# De quais endereços o navegador pode chamar a API. Use * em desenvolvimento.
CORS_ORIGIN=*

# Tamanho máximo de upload de mídia, em MB
MAX_UPLOAD_MB=15

# ===== SUPABASE (banco de dados) =====
# Pegue esses valores no painel do Supabase:
#   Project Settings -> Data API  -> Project URL
#   Project Settings -> API Keys   -> service_role (secret)
# ATENÇÃO: a service_role é SECRETA. Nunca coloque no frontend nem no Git.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui
